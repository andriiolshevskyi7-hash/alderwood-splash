# Alderwood studio splash screen.
# Self-contained: no autoloads, no game-specific dependencies. Godot 4.3+.
# Source of truth: https://github.com/andriiolshevskyi7-hash/alderwood-splash
# Do not edit this file inside a game - change it in the alderwood-splash repo.
extends Control

## Scene to open after the splash finishes (or is skipped by a tap).
@export_file("*.tscn", "*.scn") var next_scene: String = "res://main.tscn"

## Logo width as a fraction of the screen width.
@export_range(0.1, 1.0, 0.01) var logo_width_ratio: float = 0.4

const FADE_IN := 0.4
const HOLD := 1.2
const FADE_OUT := 0.4
const START_SCALE := 0.92

@onready var _logo: TextureRect = $Logo

var _tween: Tween
var _leaving := false


func _ready() -> void:
	resized.connect(_layout)
	_layout()
	_logo.modulate.a = 0.0
	_logo.scale = Vector2(START_SCALE, START_SCALE)

	_tween = create_tween().set_parallel(true)
	_tween.tween_property(_logo, "modulate:a", 1.0, FADE_IN) \
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	_tween.tween_property(_logo, "scale", Vector2.ONE, FADE_IN) \
		.set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_OUT)
	_tween.chain().tween_interval(HOLD)
	_tween.chain().tween_property(_logo, "modulate:a", 0.0, FADE_OUT) \
		.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN)
	_tween.chain().tween_callback(_go_next)


func _layout() -> void:
	var tex := _logo.texture
	if tex == null:
		return
	var w := size.x * logo_width_ratio
	var h := w * float(tex.get_height()) / float(tex.get_width())
	# Anchors are at the screen centre; offsets make the logo centred around it.
	_logo.offset_left = -w * 0.5
	_logo.offset_right = w * 0.5
	_logo.offset_top = -h * 0.5
	_logo.offset_bottom = h * 0.5
	_logo.pivot_offset = Vector2(w, h) * 0.5


func _input(event: InputEvent) -> void:
	var tapped := false
	if event is InputEventScreenTouch:
		tapped = (event as InputEventScreenTouch).pressed
	elif event is InputEventMouseButton:
		tapped = (event as InputEventMouseButton).pressed
	else:
		tapped = event.is_action_pressed("ui_accept")
	if tapped:
		get_viewport().set_input_as_handled()
		_go_next()


func _go_next() -> void:
	if _leaving:
		return
	_leaving = true
	if _tween and _tween.is_valid():
		_tween.kill()
	if next_scene.is_empty() or not ResourceLoader.exists(next_scene):
		push_error("Alderwood splash: next_scene not found: '%s'" % next_scene)
		return
	get_tree().call_deferred("change_scene_to_file", next_scene)
